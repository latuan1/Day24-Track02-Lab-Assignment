#!/bin/bash
# Pre-commit hook: run security checks before commit.

set -e

echo "Running security checks..."

if [ ! -d "src" ] && [ -d "medviet-governance/src" ]; then
    cd medviet-governance
fi

run_python_module() {
    if [ -x ".venv/Scripts/python.exe" ]; then
        ".venv/Scripts/python.exe" -m "$@"
    elif [ -x ".venv/bin/python" ]; then
        ".venv/bin/python" -m "$@"
    else
        python -m "$@"
    fi
}

# 1. git-secrets scan
git secrets --pre_commit_hook -- "$@"
echo "git-secrets scan passed."

# 2. Bandit SAST scan
echo "Running Bandit SAST..."
run_python_module bandit -r src/ -ll -q
echo "Bandit scan passed."

# 3. pip-audit dependency check
echo "Checking dependencies for CVEs..."
run_python_module pip_audit --desc on
echo "pip-audit check passed."

echo "All security checks passed."
